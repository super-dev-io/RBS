generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BIDDER
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Admin relations
  createdBidders     User[]              @relation("AdminBidders")
  adminId            String?             @map("admin_id") @db.Uuid
  admin              User?               @relation("AdminBidders", fields: [adminId], references: [id], onDelete: SetNull)
  createdProfiles    Profile[]           @relation("AdminProfiles")
  createdTemplates   ResumeTemplate[]    @relation("AdminTemplates")
  createdAssignments ProfileAssignment[] @relation("AdminAssignments")

  // Bidder relations
  assignments   ProfileAssignment[] @relation("BidderAssignments")
  generations   ResumeGeneration[]  @relation("BidderGenerations")
  workLogs      WorkLog[]           @relation("BidderWorkLogs")
  refreshTokens RefreshToken[]

  @@index([role])
  @@index([adminId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Profile {
  id                   String          @id @default(uuid()) @db.Uuid
  fullName             String          @map("full_name")
  linkedinUrl          String?         @map("linkedin_url")
  email                String
  phoneNumber          String?         @map("phone_number")
  address              String?
  masterPrompt         String          @map("master_prompt") @db.Text
  defaultPdfTemplateId String?         @map("default_pdf_template_id") @db.Uuid
  defaultPdfTemplate   ResumeTemplate? @relation("ProfileDefaultTemplate", fields: [defaultPdfTemplateId], references: [id], onDelete: SetNull)
  createdByAdminId     String          @map("created_by_admin_id") @db.Uuid
  createdByAdmin       User            @relation("AdminProfiles", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  assignments ProfileAssignment[]
  generations ResumeGeneration[]
  workLogs    WorkLog[]

  @@index([createdByAdminId])
  @@map("profiles")
}

model ProfileAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bidderId     String   @map("bidder_id") @db.Uuid
  bidder       User     @relation("BidderAssignments", fields: [bidderId], references: [id], onDelete: Cascade)
  assignedById String   @map("assigned_by_id") @db.Uuid
  assignedBy   User     @relation("AdminAssignments", fields: [assignedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([profileId, bidderId])
  @@index([bidderId])
  @@index([profileId])
  @@map("profile_assignments")
}

model ResumeTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  htmlTemplate     String   @map("html_template") @db.Text
  cssStyles        String   @map("css_styles") @db.Text
  thumbnailUrl     String?  @map("thumbnail_url")
  createdByAdminId String   @map("created_by_admin_id") @db.Uuid
  createdByAdmin   User     @relation("AdminTemplates", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  defaultForProfiles Profile[]          @relation("ProfileDefaultTemplate")
  generations        ResumeGeneration[]

  @@index([createdByAdminId])
  @@map("resume_templates")
}

model ResumeGeneration {
  id               String           @id @default(uuid()) @db.Uuid
  bidderId         String           @map("bidder_id") @db.Uuid
  bidder           User             @relation("BidderGenerations", fields: [bidderId], references: [id], onDelete: Cascade)
  profileId        String           @map("profile_id") @db.Uuid
  profile          Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  templateId       String           @map("template_id") @db.Uuid
  template         ResumeTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  companyName      String           @map("company_name")
  roleTitle        String           @map("role_title")
  jobDescription   String           @map("job_description") @db.Text
  status           GenerationStatus @default(PENDING)
  aiProvider       String?          @map("ai_provider")
  aiModel          String?          @map("ai_model")
  generatedContent Json?            @map("generated_content")
  pdfPath          String?          @map("pdf_path")
  pdfUrl           String?          @map("pdf_url")
  errorMessage     String?          @map("error_message") @db.Text
  jobId            String?          @map("job_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  completedAt      DateTime?        @map("completed_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workLog WorkLog?

  @@index([bidderId])
  @@index([profileId])
  @@index([status])
  @@index([createdAt])
  @@map("resume_generations")
}

model WorkLog {
  id                String            @id @default(uuid()) @db.Uuid
  bidderId          String            @map("bidder_id") @db.Uuid
  bidder            User              @relation("BidderWorkLogs", fields: [bidderId], references: [id], onDelete: Cascade)
  profileId         String            @map("profile_id") @db.Uuid
  profile           Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  companyName       String            @map("company_name")
  roleTitle         String            @map("role_title")
  generationStatus  GenerationStatus  @map("generation_status")
  generatedResumeId String?           @unique @map("generated_resume_id") @db.Uuid
  generatedResume   ResumeGeneration? @relation(fields: [generatedResumeId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now()) @map("created_at")
  completedAt       DateTime?         @map("completed_at")

  @@index([bidderId, createdAt])
  @@index([profileId])
  @@map("work_logs")
}
